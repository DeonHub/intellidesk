# Server
PORT=4000
NODE_ENV=development

# MongoDB — paste your Atlas or local connection string
# Example Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/intellidesk?retryWrites=true&w=majority
# Example local: mongodb://127.0.0.1:27017/intellidesk
# If unset/unreachable locally, the API falls back to an in-memory MongoDB for demos.
MONGODB_URI=mongodb://127.0.0.1:27017/intellidesk

# Force in-memory MongoDB (local demo only — data is wiped when the server stops)
USE_IN_MEMORY_MONGO=false

# JWT — use a long random secret in production
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — comma-separated frontend origins (Netlify URL + local Vite)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NVIDIA NIM — leave empty to disable chatbot (API returns "not available")
# Get a key: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MAX_TOKENS=512

# Auto-seed demo users on startup (set to false in production after first seed)
SEED_ON_START=true
